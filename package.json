{
  "name": "dragonwave-backend",
  "version": "1.0.0",
  "description": "Backend for DragonWave 2026 Race Management System (Standalone Version)",
  "main": "server.js",
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "marked": "^18.0.2",
    "socket.io": "^4.8.3"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:watch": "node --watch --watch-path=server.js --watch-path=database.js --watch-path=dragon.js --watch-path=js/ js/lint-watch.js",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "html-to-docx": "^1.8.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^17.0.5",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.8.3"
  }
}
