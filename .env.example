# DragonWave 2026 - Környezeti Változók Példafájl
# Másold le ezt a fájlt .env néven a gyökérmappában, és töltsd ki a saját adataiddal!

# Supabase Adatbázis Csatlakozás
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here
# Opcionális (ha a database.js-ben anon kulcsra váltasz a javítás után):
# SUPABASE_ANON_KEY=your-anon-public-key-here

# Adminisztrátori hitelesítés
ADMIN_PASSWORD=dragon2026

# Barion Fizetési Kapu (Szimulációs vagy éles kulcs)
BARION_POS_KEY=your-barion-poskey-here

# Szerver port beállítása
PORT=3001
